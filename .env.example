# --- Supabase (server only; the secret key bypasses RLS, never expose it to the browser)
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# --- Hiring dashboard (/hiring)
# Gemini key from a project with BILLING ENABLED. The free AI Studio tier may train on prompts.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# Leave blank until you reach the Resend step.
RESEND_API_KEY=
# From address. onboarding@resend.dev works until you verify your own domain (and then only delivers to your Resend account email).
# RESEND_FROM="Arjun at Kargo <onboarding@resend.dev>"
# While testing, send every email to this inbox instead of the candidate's address.
# RESEND_TEST_RECIPIENT=
# HIRING_REPLY_TO=
# Protects /hiring and /api/hiring with HTTP Basic auth (any username). Set this on any public deploy.
DASHBOARD_PASSWORD=
# SHORTLIST_SIZE=5
